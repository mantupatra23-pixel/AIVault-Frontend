{
  "redirects": [
    {
      "source": "/tools/:slug*",
      "destination": "/tool/:slug*",
      "permanent": true
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt).*)",
      "has": [
        {
          "type": "host",
          "value": "ai-vault-frontend-blue.vercel.app"
        }
      ],
      "destination": "https://aivault.pp.ua/:1",
      "permanent": true
    }
  ]
}
